{
  "version": 1,
  "sourcePolicy": {
    "directory": "art/source/sprites/references",
    "immutable": true,
    "description": "Los archivos de referencia, artwork y animaciones versionados son fuentes inmutables. Las pruebas y validadores solo inspeccionan los recursos existentes."
  },
  "categories": {
    "characterArtwork": {
      "format": "png",
      "canvasPolicy": "match-family-master",
      "preserveArtworkScale": true,
      "allowResampling": false,
      "allowCropping": false,
      "mismatchCorrection": "none",
      "alignment": "center",
      "families": {
        "male": {
          "reference": "art/source/sprites/results/male/orange/super-orange/super-orange.png",
          "width": 857,
          "height": 1171
        },
        "female": {
          "reference": "art/source/sprites/references/axem-pink/super-pink.png",
          "width": 745,
          "height": 1372
        }
      },
      "additionalReferences": [
        "art/source/sprites/results/female/violet/super-violet.png",
        "art/source/sprites/results/male/super-brown.png",
        "art/source/sprites/results/male/super-gray.png"
      ]
    },
    "combatTexture": {
      "width": 53,
      "height": 83,
      "alphaRequired": true,
      "feetY": 27
    },
    "menuPortrait": {
      "width": 104,
      "height": 150,
      "alphaRequired": true
    },
    "actionGif": {
      "width": 150,
      "height": 100,
      "canvasPolicy": "fixed-native-frame",
      "pixelScale": "1:1",
      "allowResampling": false,
      "allowCropping": false,
      "alphaRequired": true,
      "frameDelayMs": 100,
      "frameRateFps": 10,
      "directory": "art/source/sprites/results/male/orange",
      "additionalDirectories": [
        "art/source/sprites/results/male/white"
      ],
      "recursive": true,
      "preserveFrameCount": true,
      "preserveFrameTiming": true,
      "referenceDirectory": "art/source/sprites/references/axem-red",
      "referenceFiles": [
        "axem-red-axe-dash.gif",
        "axem-red-battle-channelling-pose.gif",
        "axem-red-bike-down.gif",
        "axem-red-bike-up.gif",
        "axem-red-bike.gif",
        "axem-red-channelling-attack-01.gif",
        "axem-red-channelling-attack-02.gif",
        "axem-red-channelling-attack-03.gif",
        "axem-red-channelling-block.gif",
        "axem-red-channelling-dash.gif",
        "axem-red-channelling-idle.gif",
        "axem-red-channelling-jump.gif",
        "axem-red-channelling-ko.gif",
        "axem-red-channelling-pose.gif",
        "axem-red-channelling-run.gif",
        "axem-red-defeated.gif",
        "axem-red-hit.gif",
        "axem-red-hurt.gif",
        "axem-red-levitate.gif",
        "axem-red-nitro-bike.gif",
        "axem-red-special-attack.gif",
        "axem-red-teleport.gif"
      ],
      "files": [
        "axem-orange-bike.gif",
        "axem-orange-run.gif",
        "axem-orange-idle.gif",
        "axem-orange-dash.gif",
        "axem-orange-punch-01.gif",
        "axem-orange-punch-02.gif",
        "axem-orange-punch-03.gif",
        "axem-orange-hit.gif",
        "axem-orange-hurt.gif",
        "axem-orange-jump.gif",
        "axem-orange-teleport.gif",
        "axem-orange-charge.gif",
        "axem-orange-pose.gif",
        "axem-orange-guard.gif",
        "axem-orange-roll.gif",
        "axem-orange-ko.gif"
      ]
    },
    "otherProcessedSprites": {
      "policy": "preserve-native-dimensions",
      "alphaRequired": true,
      "description": "Armas, objetos, recursos suplementarios y efectos conservan sus dimensiones de origen."
    },
    "effectAnimation": {
      "assetPolicy": "manual-immutable",
      "directories": [
        "art/source/effects/axem",
        "art/source/effects/canon",
        "art/source/effects/sparks"
      ],
      "alphaRequired": true,
      "minimumFrames": 2,
      "validateFrameTiming": true,
      "description": "Los GIF de efectos son recursos manuales inmutables. La validación solo inspecciona y decodifica los archivos existentes; nunca genera, reemplaza, elimina ni normaliza recursos."
    },
    "backgrounds": {
      "policy": "preserve-source-aspect-ratio",
      "crop": "explicit-per-stage-only",
      "description": "Los fondos y tilesets no se estiran a un lienzo global; cada escena define su encuadre."
    },
    "referenceSheet": {
      "policy": "match-family-master",
      "preserveIrregularLayout": true,
      "allowResampling": false,
      "allowCropping": false,
      "families": [],
      "format": "png",
      "files": [
        "art/source/sprites/references/axem-rangers-x-spritesheet-2.png"
      ]
    }
  },
  "description": "Los PNG y GIF versionados son la fuente de verdad del proyecto. No se generan ni normalizan recursos durante test, build o CI."
}
