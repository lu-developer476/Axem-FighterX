{
  "version": 1,
  "sourcePolicy": {
    "directory": "art/source/sprites/references",
    "immutable": true,
    "description": "Los masters de artwork son inmutables. art/source/sprites/references/axem-red conserva únicamente super-axem-ranger-red.png y axem-ranger-bike.gif. Las secuencias de correr se derivan de results/male/orange/spritesheet.png y de su mapa de recortes versionado; no requieren GIFs ni atlas adicionales en references."
  },
  "categories": {
    "characterArtwork": {
      "format": "png",
      "canvasPolicy": "match-family-master",
      "preserveArtworkScale": true,
      "allowResampling": "nearest-neighbor-only",
      "allowCropping": false,
      "mismatchCorrection": "uniform-nearest-neighbor-scale-and-transparent-padding",
      "alignment": "center",
      "families": {
        "male": {
          "reference": "art/source/sprites/results/male/orange/super-axem-ranger-orange.png",
          "result": "art/source/sprites/results/male/orange/super-axem-ranger-orange.png",
          "preparedSource": "public/generated/super-axem-source-male.png",
          "width": 857,
          "height": 1171,
          "note": "El artwork Super Axem masculino canónico se reutiliza como fuente preparada; ya no se mantiene una referencia Red redundante.",
          "visualBoundsReference": "art/source/sprites/results/male/orange/super-axem-ranger-orange.png",
          "visualBoundsTolerance": 2,
          "visualBoundsRatioTolerance": 0.04,
          "alignment": "horizontal-center-and-feet-baseline"
        },
        "female": {
          "reference": "art/source/sprites/references/axem-pink/super-axem-pink.png",
          "preparedSource": "public/generated/super-axem-source-female.png",
          "width": 745,
          "height": 1372
        }
      }
    },
    "combatTexture": {
      "width": 53,
      "height": 83,
      "alphaRequired": true,
      "outputs": [
        "public/generated/ranger-male-orange.png"
      ],
      "feetY": 27
    },
    "menuPortrait": {
      "width": 104,
      "height": 150,
      "alphaRequired": true,
      "outputs": [
        "public/generated/menu-ranger-male-orange.png"
      ]
    },
    "actionGif": {
      "width": 150,
      "height": 100,
      "alphaRequired": true,
      "frameDelayMs": 100,
      "frameRateFps": 10,
      "directory": "art/source/sprites/results/male/orange",
      "recursive": true,
      "preserveFrameCount": true,
      "preserveFrameTiming": true,
      "referenceDirectory": "art/source/sprites/references/axem-red",
      "referenceFiles": [
        "axem-ranger-bike.gif"
      ],
      "files": [
        "bike.gif",
        "run.gif",
        "idle.gif",
        "dash.gif",
        "punch-01.gif",
        "punch-02.gif",
        "punch-03.gif",
        "hit.gif",
        "hurt.gif",
        "jump.gif",
        "teleport.gif",
        "charge.gif",
        "pose.gif",
        "guard.gif",
        "roll.gif",
        "ko.gif"
      ]
    },
    "actionFrameCell": {
      "width": 86,
      "height": 57,
      "feetY": 55
    },
    "otherProcessedSprites": {
      "policy": "preserve-native-dimensions",
      "alphaRequired": true,
      "description": "Armas, objetos, recursos suplementarios y efectos conservan sus dimensiones de origen."
    },
    "effectAnimation": {
      "sourcePolicy": "immutable",
      "outputPolicy": "animated-transparent-gif",
      "preserveSourceDimensions": false,
      "files": [
        {
          "source": "art/source/effects/axem/big-white-explotion.png",
          "output": "art/source/effects/axem/big-white-explotion.gif",
          "mode": "horizontal-cells",
          "frameDelay": 100,
          "minFrames": 3,
          "frameCount": 3,
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true,
          "frameLayout": "horizontal-cells"
        },
        {
          "source": "art/source/effects/axem/white-explotion.png",
          "output": "art/source/effects/axem/white-explotion.gif",
          "mode": "horizontal-cells",
          "frameDelay": 85,
          "minFrames": 8,
          "frameCount": 8,
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true,
          "frameLayout": "horizontal-cells"
        },
        {
          "source": "art/source/effects/canon/normal-canon-shoot.png",
          "output": "art/source/effects/canon/normal-canon-shoot.gif",
          "mode": "horizontal-cells",
          "frameDelay": 55,
          "minFrames": 7,
          "frameCount": 7,
          "frameLayout": "horizontal-cells",
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true
        },
        {
          "source": "art/source/effects/canon/special-canon-shoot.png",
          "output": "art/source/effects/canon/special-canon-shoot.gif",
          "mode": "horizontal-cells",
          "frameDelay": 65,
          "minFrames": 8,
          "frameCount": 8,
          "frameLayout": "horizontal-cells",
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true
        },
        {
          "source": "art/source/effects/canon/turquoise-canon-shoot.png",
          "output": "art/source/effects/canon/turquoise-canon-shoot.gif",
          "mode": "horizontal-cells",
          "frameDelay": 55,
          "minFrames": 6,
          "frameCount": 6,
          "frameLayout": "horizontal-cells",
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true
        },
        {
          "source": "art/source/effects/sparks/turquoise-effect.png",
          "output": "art/source/effects/sparks/turquoise-effect.gif",
          "mode": "horizontal-cells",
          "frameDelay": 75,
          "frameCount": 8,
          "frameLayout": "horizontal-cells",
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true,
          "minFrames": 8
        },
        {
          "source": "art/source/effects/sparks/yellow-effect.png",
          "output": "art/source/effects/sparks/yellow-effect.gif",
          "mode": "horizontal-cells",
          "frameDelay": 75,
          "frameCount": 8,
          "frameLayout": "horizontal-cells",
          "backgroundRemoval": "white",
          "whiteThreshold": 250,
          "strictFrameCount": true,
          "minFrames": 8
        }
      ],
      "preserveFrameHeight": true,
      "frameWidthPolicy": "ceil-source-width-divided-by-frame-count",
      "description": "Cada PNG horizontal se divide en celdas reales; cada GIF conserva un fotograma por celda, el alto de origen y el fondo transparente."
    },
    "backgrounds": {
      "policy": "preserve-source-aspect-ratio",
      "crop": "explicit-per-stage-only",
      "description": "Los fondos y tilesets no se estiran a un lienzo global; cada escena define su encuadre."
    },
    "referenceSheet": {
      "policy": "match-family-master",
      "preserveIrregularLayout": true,
      "allowResampling": false,
      "allowCropping": false,
      "families": []
    }
  },
  "description": "La carpeta axem-red conserva exclusivamente el master de artwork Red y el GIF maestro de bicicleta. Las acciones de correr, salto, golpes y demás movimientos se derivan del spritesheet Orange versionado y de los generadores del proyecto."
}
