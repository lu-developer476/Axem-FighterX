{
  "version": 1,
  "sourcePolicy": {
    "directory": "references",
    "treatment": "preserve-originals",
    "description": "Los archivos de references son masters de origen; no se sobrescriben. Los generadores existentes los convierten a resultados transparentes."
  },
  "processedPolicy": {
    "directory": "results",
    "recursive": true,
    "extensions": [
      ".png",
      ".gif"
    ],
    "requireAlpha": true,
    "backgroundRemoval": {
      "mode": "connected-border-color",
      "tolerance": 28,
      "minBorderCoverage": 0.22,
      "preserveEnclosedPixels": true,
      "failWhenOpaqueAndUnknown": true
    },
    "output": {
      "preserveNativeDimensions": true,
      "preserveAnimationFrames": true,
      "preserveAnimationTiming": true
    },
    "artworkEdgeTreatment": {
      "male/orange/super-axem-ranger-orange.png": {
        "edgeAlphaFloor": 216,
        "fringeLimit": 44,
        "coverageStart": 7,
        "coverageRange": 32,
        "preserveInteriorPixels": true,
        "preserveRGB": true,
        "resampling": false,
        "blur": false,
        "sharpen": false,
        "description": "Quita solo el fondo oscuro conectado al borde. Suaviza el alfa periférico sin borrar píxeles del personaje ni alterar sus colores."
      }
    },
    "excludedFiles": [
      "male/orange/super-axem-ranger-orange.png",
      "male/orange/super-axem-ranger-orange.PNG",
      "male/orange/source/super-axem-orange-upload.png",
      "female/violet/super-axem-ranger-violet.png",
      "female/violet/source/super-axem-violet-upload.png"
    ]
  },
  "pixelArt": {
    "resizeKernel": "nearest",
    "imageSmoothing": false,
    "antialias": false,
    "sharpen": false,
    "preserveNativeResolution": true,
    "description": "Contornos de píxel nítidos. No aplicar blur, sharpen ni interpolación bilineal."
  }
}
